<?xml version="1.0" encoding="utf-8"?>
<!--
  Lint baseline configuration for BareLauncher.

  Philosophy: lint runs on every build and fails on real errors. Issues
  that would require invasive refactoring are downgraded to warnings (not
  silenced) so they appear in the lint report without failing the build.
  As the codebase evolves, the goal is to remove entries from this file —
  not add to them.

  The full list of suppressible lint issue ids is in
  https://googlesamples.github.io/android-custom-lint-rules/checks/index.md.html
-->
<lint>

    <!-- The launcher avoids depending on AndroidX appcompat / fragments
         and uses programmatic UI throughout. Several lint families that
         assume an appcompat / Material setup are not relevant here. -->

    <!-- Programmatic Views are constructed with `new TextView(this)` etc.
         and configured via setters. Lint can't see those setter calls so
         it warns about missing setLabelFor / contentDescription on every
         TextView — which is wrong: contentDescription is set on the
         interactive views that actually need it. -->
    <issue id="LabelFor"           severity="warning" />

    <!-- AdaptiveIconDrawable is created via Drawable rather than via the
         vector resource path, which is the right choice on a launcher
         that draws from PackageManager.loadIcon. -->
    <issue id="VectorPath"         severity="ignore" />

    <!-- minSdk = 26, targetSdk now tracks the latest platform (36 / Android
         16). Keep this as a warning rather than ignored so that when a
         newer platform ships and we miss a bump, lint loudly reminds us. -->
    <issue id="OldTargetApi"       severity="warning" />

    <!-- Programmatic Paint construction inside onDraw is documented as a
         performance anti-pattern, but every Paint in this codebase is
         pre-allocated (see makeBtnStrokePaint / makeBgIdlePaint et al)
         and reused. Lint can't trace that across helper boundaries. -->
    <issue id="DrawAllocation"     severity="ignore" />

    <!-- The shelf is a custom ViewGroup that uses absolute positioning
         intentionally (RecyclingShelfView.cellLeft) — this is the whole
         point of the recycler. Lint's "use a layout manager" advice is
         for app developers, not platform-style components. -->
    <issue id="CustomViewStyleable" severity="ignore" />

    <!-- WallpaperManager.getDrawable / WallpaperManager.getInstance.
         Lint reports MissingPermission and demands READ_WALLPAPER_INTERNAL
         (signature-only) or MANAGE_EXTERNAL_STORAGE. Neither is appropriate
         for a 3rd-party HOME launcher: Android grants the active home app
         implicit access to the system wallpaper, and that's the supported
         path. The actual manifest declares READ_EXTERNAL_STORAGE for legacy
         devices (≤ API 32) and SET_WALLPAPER for write access. -->
    <issue id="MissingPermission" severity="ignore" />

    <!-- QUERY_ALL_PACKAGES is one of Google Play's documented legitimate
         use cases for HOME launchers: a launcher's whole job is to enumerate
         every installed app the user might want to launch. The manifest
         also declares a <queries> block as a fallback so the launcher works
         even when the permission is denied (rare, but possible on stripped
         ROMs). The lint check assumes consumer apps; this is a launcher. -->
    <issue id="QueryAllPackagesPermission" severity="ignore" />

    <!-- ── Structurally-required design choices ────────────────────────
         The remaining suppressions cover lint warnings that are correct
         in the abstract but inapplicable to a TV-first programmatic
         launcher. Each one was reviewed individually and ignored for
         a documented reason. -->

    <!-- The shelf is gestural by design (drag + fling, no semantic
         "click" outside the per-cell {@code OnClickListener} which IS
         wired). Adding a {@code performClick()} call inside the touch
         path would be a no-op because the parent ViewGroup is not
         clickable — only its children are. The cells (CellView) already
         have a real click listener for app launch. -->
    <issue id="ClickableViewAccessibility" severity="ignore" />

    <!-- The launcher is HOME on Android TV. Multi-window does not exist
         on Android TV (no system bar, no split-screen UI). Declaring
         resizeableActivity=true would invite the platform to recompose
         the launcher's window for a feature that physically cannot
         happen on the target hardware. The phone-sideload path is
         a debug convenience, not a supported product surface. -->
    <issue id="NonResizeableActivity" severity="ignore" />

    <!-- screenOrientation="landscape" and resizeableActivity="false"
         are flagged by lint's discouraged-API check. Both are correct
         for a TV launcher — TVs are physically landscape-only and
         the system does not offer multi-window. The decisions are
         documented inline in AndroidManifest.xml. -->
    <issue id="DiscouragedApi" severity="ignore" />

    <!-- RingView is created programmatically in
         {@link LauncherActivity#buildLayout} and never inflated from
         XML. The single-arg {@code (Context)} constructor it ships
         with is the only one that can be reached at runtime. Lint's
         layout-editor-friendly constructors don't apply. -->
    <issue id="ViewConstructor" severity="ignore" />

    <!-- The launcher icon is intentionally a banner-style adaptive
         icon background; the "should not fill every pixel" guidance
         is for app-drawer thumbnails, not a HOME launcher's own
         self-icon (which only appears in the system "Default home
         app" picker and rarely elsewhere). -->
    <issue id="IconLauncherShape" severity="ignore" />

    <!-- minSdk = 26, so the {@code mipmap-anydpi-v26} folder qualifier
         is functionally redundant — every device the launcher runs on
         is API 26+. Renaming to {@code mipmap-anydpi} would be cleaner
         but ripples through every {@code @mipmap/ic_launcher_*}
         reference; not worth the churn. -->
    <issue id="ObsoleteSdkInt" severity="ignore" />

</lint>
