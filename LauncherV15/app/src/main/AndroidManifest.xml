<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- PERMISSIONS -->

    <!-- Wallpaper reading on legacy Android (12 and below). On Android 13+
         WallpaperManager.getDrawable() is gated by the OS being the active
         home launcher, not by a permission. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Wallpaper SLIDESHOW only: browse image folders via MediaStore and read
         the chosen folder's images. Runtime-granted (a one-time "allow photos"
         prompt) and requested lazily — only when the user opens the slideshow
         folder picker. The launcher never touches media otherwise. On Android
         12 and below the READ_EXTERNAL_STORAGE above covers it.
         minSdkVersion="33": this permission does not exist before API 33 and
         the OS installer would silently ignore it on older devices anyway, but
         the attribute documents intent and suppresses lint. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"
        android:minSdkVersion="33" />

    <!-- Android 14+: partial photo library access. The user can grant
         access to only selected photos rather than the full library. We
         request this alongside READ_MEDIA_IMAGES so the system shows the
         "Select photos" option on the permission prompt. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
        android:minSdkVersion="34" />

    <!-- Set system wallpaper -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!-- Required to enumerate installed apps for the launcher grid -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- Read the active network's transport so the WiFi pill can show a
         filled (connected) vs outline (not connected) glyph. Normal
         install-time permission — no runtime prompt. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Allows launching the system uninstall dialog reliably on Android 14+
         and Android TV ROMs that gate ACTION_DELETE / ACTION_UNINSTALL_PACKAGE
         behind this normal-protection-level permission. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- HARDWARE FEATURES
         Both declared as NOT required so the APK installs on phones too
         (useful for sideloading / testing) -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- TV Input Framework: lets the launcher surface hardware inputs
         (HDMI / AV / component) as tiles and switch to them. Declared NOT
         required so the APK still installs on devices without TV inputs;
         enumeration/launch need no runtime permission (see TvInputs). -->
    <uses-feature
        android:name="android.software.live_tv"
        android:required="false" />

    <!-- PACKAGE VISIBILITY (Android 11+) -->
    <queries>

        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>

        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>

    </queries>

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.BareLauncher">

        <activity
            android:name=".LauncherActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|uiMode|locale|layoutDirection"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="stateUnspecified|adjustPan">

            <!--
                 Standard Android HOME launcher.

                 Categories:
                   HOME      — registers as a home-screen candidate so
                               the OS picks up the app in Settings →
                               Default apps → Home app.
                   DEFAULT   — needed for queryIntentActivities calls
                               that pass MATCH_DEFAULT_ONLY (the
                               PackageManager default).
                   LAUNCHER  — makes the launcher itself enumerable
                               via queryIntentActivities(MAIN+LAUNCHER).
                               Required for third-party "Launcher
                               Manager" / "set-default-launcher" tools
                               popular on XDA — they list every
                               activity matching MAIN+LAUNCHER (which
                               is how every conventional app appears
                               in an app drawer). Without LAUNCHER,
                               our launcher is invisible to those
                               tools and to any "open with" dialog
                               that probes for launchable activities.

                               Adding LAUNCHER to the same intent
                               filter (rather than as a second filter)
                               is the canonical Android pattern — see
                               AOSP packages/apps/Launcher3.

                               Note: queryApps() inside this launcher
                               self-filters by getPackageName(), so
                               our own activity does NOT appear on
                               the home shelf despite now matching
                               MAIN+LAUNCHER probes. The visibility
                               only affects external enumeration.

                 The intent-filter priority="1" stays low so OEM /
                 system launchers retain their default selection on
                 first boot; the user is the one who picks our app
                 via the system Default-launcher dialog.
            -->
            <intent-filter android:priority="1">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                 Android TV / Leanback launcher.

                 LEANBACK_LAUNCHER puts the activity on the Android TV
                 system launcher's "All apps" row.

                 DEFAULT is added in v1.3.6 so that queries with
                 MATCH_DEFAULT_ONLY (the PackageManager default) also
                 match this filter on TV. Without it, third-party
                 tools that combine MATCH_DEFAULT_ONLY with a
                 LEANBACK_LAUNCHER probe miss our activity entirely.
            -->
            <intent-filter android:priority="1">
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

        </activity>

    </application>

</manifest>
